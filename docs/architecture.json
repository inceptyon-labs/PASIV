  "cards": [
    { "dot": "cyan", "title": "Primary path", "items": ["/kick arms the state machine, then runs plan, execute, review, verification, finish as Skill calls in one turn", "Verification gate (haiku) sits between review and finish", "Execute dispatches a fresh Sonnet subagent per task for GREEN"] },
    { "dot": "rose", "title": "Hook enforcement", "items": ["kick-guard arms state on /kick and injects the step-skill rule", "post-skill advances state on each step-skill call", "stop-guard bounces turn-ends mid-kick, capped at 2 blocks", "plan-approval-guard denies the approval question until the plan is shown"] },
    { "dot": "amber", "title": "Task backends", "items": ["task-ops reads .pasiv.yml and routes to github, beans, or local", "beans-ops calls the beans CLI; local-ops writes docs/tasks/ markdown", "Default backend is local; github is opt-in"] },
    { "dot": "slate", "title": "Trust boundaries", "items": ["Everything in the plugin runs inside the user's Claude Code session on their machine", "Codex review and GitHub are the only calls leaving it", "Review also supports a shell claude -p engine when hosted by Codex"] }
